* text=auto
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.js text eol=lf
*.html text eol=lf
# CEP signatures cover exact bytes; Git must not normalize signed payloads
# or their source counterparts during staging/checkout on any platform.
plugins/premiere-control/cep/** -text
plugins/premiere-control/adobe/signed/** -text
plugins/premiere-control/adobe/signed/META-INF/signatures.xml whitespace=cr-at-eol
